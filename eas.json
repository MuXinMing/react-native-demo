{
  "cli": {
    "version": ">= 16.20.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "environment": "development",
      "distribution": "internal",
      "android": {
        // "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "developmentClient": false,
      "environment": "preview",
      "distribution": "internal"
    },
    "staging": {
      // "developmentClient": true,
      "channel": "staging",
      "environment": "development",
      "distribution": "internal",
      "android": {
        // "buildType": "apk",
        // "gradleCommand": ":app:assembleDebug"
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://express-demo-p0k8.onrender.com/api"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}